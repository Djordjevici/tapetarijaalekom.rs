# Javni Next.js URL. Compose podrazumevano koristi dev domen.
NEXT_PUBLIC_SITE_URL=https://dev.tapetarijaalekom.rs

# Dev sajt mora ostati van indeksa i bez obrade kontakt forme.
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
NEXT_PUBLIC_SHOW_DEMO_PROJECTS=true

# Opciono; bez validnog ID-a analitika se ne učitava.
NEXT_PUBLIC_GA_ID=

# Opciono i neaktivno dok je kontakt forma isključena.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
