# Forma za upit.
# Dok ovo nije "true", forma ne obrađuje lične podatke i ne šalje ništa.
# Pre uključivanja popuniti politiku privatnosti — vidi PODACI-ZA-POTVRDU.md.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false

# Resend — slanje upita sa domena. Vidi DEPLOY.md.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@tapetarijaalekom.rs
# Opciono — podrazumevano je "Tapetarija Alekom <upiti@tapetarijaalekom.rs>".
# Adresa mora biti na domenu potvrđenom u Resend-u.
# CONTACT_FROM_EMAIL=

# Google Analytics 4.
# Bez ovoga se analitika ne učitava i cookie banner se ne prikazuje.
# NEXT_PUBLIC_GA_ID=
